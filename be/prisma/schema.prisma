generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(255)
  passwordHash String    @db.VarChar(255)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  wordSets     WordSet[]
}

model WordSet {
  id          String      @id @default(cuid())
  name        String      @db.VarChar(150)
  description String?     @db.Text
  userId      String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  flashcards  Flashcard[]

  @@index([userId])
}

model Word {
  id             String           @id @default(cuid())
  word           String           @db.VarChar(100)
  normalizedWord String           @unique @db.VarChar(100)
  phonetic       String?          @db.VarChar(255)
  audioUrl       String?          @db.VarChar(500)
  createdAt      DateTime         @default(now())
  definitions    WordDefinition[]
  flashcards     Flashcard[]
}

model WordDefinition {
  id                String   @id @default(cuid())
  wordId            String
  partOfSpeech      String?  @db.VarChar(80)
  vietnameseMeaning String   @db.Text
  englishExample    String?  @db.Text
  source            String?  @db.VarChar(100)
  word              Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
}

model Flashcard {
  id           String      @id @default(cuid())
  wordId       String
  wordSetId    String
  status       String      @default("new") @db.VarChar(30)
  correctCount Int         @default(0)
  wrongCount   Int         @default(0)
  nextReviewAt DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  word         Word        @relation(fields: [wordId], references: [id], onDelete: Cascade)
  wordSet      WordSet     @relation(fields: [wordSetId], references: [id], onDelete: Cascade)
  reviewLogs   ReviewLog[]

  @@unique([wordId, wordSetId])
  @@index([wordSetId, nextReviewAt])
}

model ReviewLog {
  id         String     @id @default(cuid())
  flashcardId String
  result     String     @db.VarChar(20)
  reviewedAt DateTime   @default(now())
  flashcard  Flashcard  @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@index([flashcardId, reviewedAt])
}
